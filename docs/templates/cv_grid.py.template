"""模板：可复现的交叉验证网格（复制到 src/cv_grid.py 后按新论文改 METHODS / LEARNERS）。

设计要点（都是第一轮踩坑换来的）：
- 任何重采样/特征变换都放进 Pipeline，保证只在训练折内拟合；
- 折划分与 scripts/make_splits.py 完全一致（同样的 StratifiedKFold 参数与种子）；
- 每折一行记录：dataset/method/fold/repeat + 指标 + 用时，便于事后重算与画图。

用法：.venv/bin/python src/cv_grid.py --datasets d1,d2 --methods base,m1 --out results/grid.csv
"""

from __future__ import annotations

import argparse
import sys
import time
from pathlib import Path

import numpy as np
import pandas as pd
from sklearn.base import clone
from sklearn.metrics import (average_precision_score, brier_score_loss, f1_score,
                             roc_auc_score, root_mean_squared_error)
from sklearn.model_selection import StratifiedKFold

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from data_prep import load  # noqa: E402

#: 方法名 -> 无参工厂（或需要种子时用 lambda seed: ...）
LEARNERS: dict[str, object] = {
    # "lr": lambda seed: LogisticRegression(max_iter=2000, random_state=seed),
    # "svm": SVC(probability=True, random_state=0),
}


def metrics_row(y_true: np.ndarray, proba: np.ndarray) -> dict:
    pred = (proba >= 0.5).astype(int)
    tn, fp, fn, tp = ((pred == 0) & (y_true == 0)).sum(), ((pred == 1) & (y_true == 0)).sum(), \
        ((pred == 0) & (y_true == 1)).sum(), ((pred == 1) & (y_true == 1)).sum()
    tpr = tp / max(tp + fn, 1)
    tnr = tn / max(tn + fp, 1)
    return {
        "auc": roc_auc_score(y_true, proba),
        "pr_auc": average_precision_score(y_true, proba),
        "gmean": float(np.sqrt(tpr * tnr)),
        "f1_pos": f1_score(y_true, pred, zero_division=0),
        "brier": brier_score_loss(y_true, proba),
        "rmse": root_mean_squared_error(y_true, proba),
    }


def run(dataset: str, methods: list[str], folds: int = 5, repeats: int = 2, seed: int = 0) -> pd.DataFrame:
    X, y = load(dataset)
    rows = []
    for method in methods:
        for rep in range(repeats):
            skf = StratifiedKFold(n_splits=folds, shuffle=True, random_state=seed + rep)
            for k, (tr, te) in enumerate(skf.split(X, y), start=1):
                est = LEARNERS[method](seed + rep) if callable(LEARNERS[method]) else clone(LEARNERS[method])
                t0 = time.time()
                est.fit(X.iloc[tr], y[tr])
                proba = (est.predict_proba(X.iloc[te])[:, 1] if hasattr(est, "predict_proba")
                         else np.clip(est.predict(X.iloc[te]), 0, 1))
                row = metrics_row(y[te], proba)
                row.update(dataset=dataset, method=method, repeat=rep, fold=k, seconds=round(time.time() - t0, 3))
                rows.append(row)
    return pd.DataFrame(rows)


def summarize(df: pd.DataFrame) -> pd.DataFrame:
    g = df.groupby(["dataset", "method"], sort=False)
    return g.agg(n=("auc", "size"), auc_mean=("auc", "mean"), auc_std=("auc", "std"),
                 pr_auc_mean=("pr_auc", "mean"), gmean_mean=("gmean", "mean"),
                 brier_mean=("brier", "mean"), seconds_mean=("seconds", "mean")).reset_index()


def main(argv=None) -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--datasets", required=True)
    p.add_argument("--methods", required=True, choices=sorted(LEARNERS))
    p.add_argument("--folds", type=int, default=5)
    p.add_argument("--repeats", type=int, default=2)
    p.add_argument("--seed", type=int, default=0)
    p.add_argument("--out", default="results/grid.csv")
    a = p.parse_args(argv)

    frames = []
    for ds in a.datasets.split(","):
        df = run(ds.strip(), a.methods.split(","), a.folds, a.repeats, a.seed)
        frames.append(df)
        print(f"[{ds}] {len(df)} folds", flush=True)
    raw = pd.concat(frames, ignore_index=True)
    out = ROOT / a.out
    out.parent.mkdir(parents=True, exist_ok=True)
    raw.to_csv(out, index=False)
    summarize(raw).to_csv(out.with_name(out.stem + "_summary.csv"), index=False)
    print(f"wrote {out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

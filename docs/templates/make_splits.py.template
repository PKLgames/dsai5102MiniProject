"""模板：生成折划分 + 数据契约清单（复制到 scripts/make_splits.py 后按新论文改 load()）。

约定：
- 单一数据入口是 src/data_prep.py 的 `load(name) -> (X: DataFrame, y: ndarray)`，y 中 1 = 正类/少数类；
- 划分固定 `StratifiedKFold(shuffle=True, random_state=seed+rep)`，与 cv_grid.py 逐索引一致；
- splits.json 体积大（数十 MB），不入库，任何人重跑得到同一文件。

用法：.venv/bin/python scripts/make_splits.py [--datasets all|a,b] [--folds 5 --repeats 2 --seed 0]
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import numpy as np
from sklearn.model_selection import StratifiedKFold

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))
from data_prep import DATASETS, load  # noqa: E402  # 新论文里改成自己的入口

SPLITS = ROOT / "data/processed/splits.json"
MANIFESTS = ROOT / "data/manifests"
#: 论文报告的数据集样本数（防止拿错版本）：name -> (n, n_positive)
PAPER_COUNTS: dict[str, tuple[int, int]] = {}


def check(name: str, y: np.ndarray) -> None:
    if name in PAPER_COUNTS:
        want_n, want_pos = PAPER_COUNTS[name]
        if len(y) != want_n or int(y.sum()) != want_pos:
            raise ValueError(f"{name}: 论文 {want_n}/{want_pos} vs 实际 {len(y)}/{int(y.sum())}")


def main(argv=None) -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--datasets", default="all")
    p.add_argument("--folds", type=int, default=5)
    p.add_argument("--repeats", type=int, default=2)
    p.add_argument("--seed", type=int, default=0)
    a = p.parse_args(argv)

    names = list(DATASETS) if a.datasets == "all" else [s for s in a.datasets.split(",") if s]
    MANIFESTS.mkdir(parents=True, exist_ok=True)
    SPLITS.parent.mkdir(parents=True, exist_ok=True)

    payload = {"seed": a.seed, "folds": a.folds, "repeats": a.repeats, "datasets": {}}
    for name in names:
        X, y = load(name)
        check(name, y)
        splits = {}
        for rep in range(a.repeats):
            skf = StratifiedKFold(n_splits=a.folds, shuffle=True, random_state=a.seed + rep)
            for k, (tr, te) in enumerate(skf.split(X, y), start=1):
                splits[f"rep{rep}_fold{k}"] = {"train": tr.tolist(), "test": te.tolist()}
        payload["datasets"][name] = {"n": int(len(y)), "n_positive": int(y.sum()), "splits": splits}
        (MANIFESTS / f"{name}.json").write_text(json.dumps({
            "dataset": name, "n": int(len(y)), "n_features": int(X.shape[1]),
            "n_positive": int(y.sum()), "n_negative": int((1 - y).sum()),
            "columns": [str(c) for c in X.columns],
            "dtypes": {str(c): str(t) for c, t in X.dtypes.items()},
            "nan_total": int(X.isna().sum().sum()),
        }, ensure_ascii=False, indent=2))
        print(f"[{name}] n={len(y)} pos={int(y.sum())} folds={len(splits)}", flush=True)

    SPLITS.write_text(json.dumps(payload, ensure_ascii=False))
    print(f"wrote {SPLITS} ({SPLITS.stat().st_size / 1e6:.2f} MB)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
